<div id="channel" {{on-render this.onAfterRender}}
                  {{on-change @channel this.channelChanged}}>
  <main>
    <header id="channel-header">
      <h2 id="channel-name"
          class={{if @channel.connected "connected" "disconnected"}}
          {{on "click" (fn this.menu "global" "toggle")}}>
        {{@channel.displayName}}
      </h2>
      <p id="channel-title">
        {{@channel.formattedTopic}}
      </p>
      <nav id="channel-nav">
        <LinkTo @route="channel.index" @model={{@channel}} {{on "click" (fn this.menu "channel" "show")}}>
          <Icon::users />
        </LinkTo>
        <LinkTo @route="channel.shares" @model={{@channel}} {{on "click" (fn this.menu "channel" "show")}}>
          <Icon::paperclip />
        </LinkTo>
        <LinkTo @route="channel.settings" @model={{@channel}} {{on "click" (fn this.menu "channel" "show")}}>
          <Icon::info />
        </LinkTo>
        <a {{on "click" (fn this.leaveChannel @channel)}} title="Leave {{@channel.displayName}}">
          <Icon::log-out />
        </a>
      </nav>
    </header>

    <div class="content-container {{@sidebarClass}} {{if @showChannelMenu "channel-menu-open"}}">
      <div class="content">
        <ChatScroller id="channel-content"
                      class="main pt-4 pb-8 bg-white text-neutral-800"
                      tabindex="-1"
                      @items={{this.renderedMessages}}
                      @resetKey={{@channel}}
                      @hasOlder={{this.canLoadOlderMessages}}
                      @isLoadingOlder={{this.isLoadingOlderMessages}}
                      @historyCursor={{@channel.searchedPreviousLogsUntilDate}}
                      @onLoadOlder={{this.loadOlderMessages}}
                      as |scroll|>
          {{#if this.historyLoadFailed}}
            <div class="history-load-error pt-4 text-center text-sm text-neutral-600" role="alert">
              Couldn’t load older messages.
              <button type="button" class="retry" {{on "click" this.retryLoadOlderMessages}}>Retry</button>
            </div>
          {{else if this.showHistoryStart}}
            <div class="history-start pt-4 text-center text-sm text-neutral-600">
              Beginning of history
            </div>
          {{/if}}

          <ul class="list-none">
            {{#each this.renderedMessages key="key" as |message|}}
              <li data-message-key={{message.key}}>
                {{#if (eq message.type "message-chat-me")}}
                  <MessageChatMe @message={{message}} @channel={{@channel}}
                                 @sendMessage={{@onMessage}}
                                 @onUsernameClick={{this.addUsernameMentionToMessage}} />
                {{else if (eq message.type "date-headline")}}
                  <DateHeadline @message={{message}} />
                {{else}}
                  <MessageChat @message={{message}} @channel={{@channel}}
                               @sendMessage={{@onMessage}}
                               @onUsernameClick={{this.addUsernameMentionToMessage}} />
                {{/if}}
              </li>
            {{else}}
              <li class="px-4 text-neutral-400">
              {{#if (eq @channel.protocol "IRC")}}
                {{#if @channel.isLogged}}
                  No recent messages to display.
                {{else}}
                  No Kosmos logs configured for this channel. <a href="https://wiki.kosmos.org/Setting_up_channel_logs" target="_blank" rel="noopener noreferrer">Learn more</a>
                {{/if}}
              {{else}}
                  No recent messages to display.
              {{/if}}
              </li>
            {{/each}}
          </ul>

          {{! Zero-height sticky zone so the button is pinned to the viewport edge
              without ever contributing to the scroll content's height. If the
              button were in flow, adding/removing it would change scrollHeight
              and shift the view by the button's height. }}
          <div class="jump-to-latest-zone">
            {{#unless scroll.isAtBottom}}
              <button type="button"
                      class="jump-to-latest {{if scroll.showJumpToLatest "has-new-messages"}}"
                      title="Scroll to latest messages"
                      {{on "click" scroll.scrollToBottom}}>
                <span aria-hidden="true"><Icon::chevron-down /></span>
                <span class="sr-only">Scroll to latest messages</span>
                {{#if scroll.newMessageCount}}
                  <span>
                    {{scroll.newMessageCount}}
                    {{if (eq scroll.newMessageCount 1) "new message" "new messages"}}
                  </span>
                {{/if}}
              </button>
            {{/unless}}
          </div>
        </ChatScroller>

        <footer>
          <MessageInput @message={{@newMessage}}
                        @sendMessage={{this.processMessageOrCommand}}
                        @usernames={{@channel.userList}} />
        </footer>
      </div>

      <aside id="channel-sidebar">
        {{yield}}
      </aside>
    </div>
  </main>
</div>
