{
  "name": "hyperchannel",
  "version": "0.14.1",
  "description": "Kosmos Web Client",
  "repository": "https://github.com/67P/hyperchannel",
  "license": "MPL",
  "author": "Kosmos Community",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "private": true,
  "scripts": {
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "NODE_ENV=development ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
    "test:ember": "ember test",
    "build": "NODE_ENV=production ember build --environment=production",
    "build-prod": "NODE_ENV=production rm -rf release/* && ember build -prod --output-path release",
    "preversion": "npm test",
    "version": "npm run build-prod && git add release/",
    "deploy": "git push 5apps master"
  },
  "engines": {
    "node": "14.* || 16.* || >= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.5",
    "@babel/plugin-proposal-decorators": "^7.22.5",
    "@csstools/postcss-sass": "^5.0.1",
    "@ember/optional-features": "^2.0.0",
    "@ember/render-modifiers": "^2.1.0",
    "@ember/string": "^3.0.1",
    "@ember/test-helpers": "^2.9.4",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@kosmos/remotestorage-module-kosmos": "^2.2.0",
    "@tailwindcss/forms": "^0.4.1",
    "autoprefixer": "^10.4.14",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^8.0.1",
    "consistent-color-generation": "0.4.0",
    "ember-auto-import": "^2.6.3",
    "ember-autofocus-modifier": "^3.1.0",
    "ember-body-class": "^2.1.1",
    "ember-cached-decorator-polyfill": "^0.1.4",
    "ember-cli": "~4.12.3",
    "ember-cli-app-version": "^6.0.0",
    "ember-cli-babel": "^7.26.11",
    "ember-cli-dependency-checker": "^3.3.2",
    "ember-cli-htmlbars": "^6.2.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-inline-content": "^0.4.1",
    "ember-cli-postcss": "^8.2.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-concurrency": "^2.3.7",
    "ember-fetch": "^8.1.2",
    "ember-keyboard-shortcuts": "github:67P/ember-keyboard-shortcuts#feature/octane_classes",
    "ember-load-initializers": "^2.1.2",
    "ember-modifier": "^4.1.0",
    "ember-moment": "^10.0.0",
    "ember-page-title": "^7.0.0",
    "ember-promise-modals": "^2.0.0",
    "ember-qunit": "^6.2.0",
    "ember-resolver": "^10.0.0",
    "ember-sinon": "^5.0.0",
    "ember-sinon-qunit": "^6.0.0",
    "ember-source": "~4.12.0",
    "ember-template-lint": "^5.7.2",
    "ember-truth-helpers": "^3.0.0",
    "eslint": "^8.43.0",
    "eslint-plugin-ember": "^11.5.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-qunit": "^7.3.4",
    "inobounce": "^0.2.1",
    "linkify-string": "^4.1.1",
    "linkifyjs": "^4.1.1",
    "loader.js": "^4.7.0",
    "localforage": "^1.10.0",
    "moment": "^2.29.4",
    "postcss": "8.4.24",
    "postcss-scss": "4.0.6",
    "qunit": "^2.19.4",
    "qunit-dom": "^2.0.0",
    "remotestoragejs": "^2.0.0-beta.6",
    "stylelint": "^15.4.0",
    "stylelint-config-standard": "^32.0.0",
    "stylelint-prettier": "^3.0.0",
    "tailwindcss": "^3.3.2",
    "tracked-built-ins": "^3.1.1",
    "webpack": "^5.88.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  }
}
