{
  "name": "hyperchannel",
  "version": "0.14.1",
  "packageManager": "pnpm@10.32.1",
  "description": "Kosmos Web Client",
  "repository": "https://github.com/67P/hyperchannel",
  "license": "MPL",
  "author": "Kosmos Community",
  "private": true,
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "build-prod": "NODE_ENV=production rm -rf release/* && vite build --outDir release",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "NODE_ENV=development vite",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "vite build --mode development && testem ci --port 0",
    "preversion": "pnpm test",
    "version": "pnpm run build-prod && git add release/",
    "deploy": "git push 5apps master"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["@parcel/watcher"]
  },
  "ember": {
    "edition": "octane"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.25",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.7",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.13",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@kosmos/remotestorage-module-kosmos": "^2.2.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@sockethub/client": "^5.0.0-alpha.25",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.6.1",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "consistent-color-generation": "0.4.0",
    "decorator-transforms": "^2.4.0",
    "ember-autofocus-modifier": "^8.0.0",
    "ember-cli": "~7.3.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-moment": "^11.1.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-sinon-qunit": "^7.5.0",
    "ember-source": "~7.3.0",
    "ember-template-lint": "^7.9.3",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "hammerjs": "^2.0.8",
    "linkify-string": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "localforage": "^1.10.0",
    "moment": "^2.31.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "remotestoragejs": "^2.0.0-beta.10",
    "sass": "^1.105.0",
    "sinon": "^22.1.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19",
    "testem": "^3.21.0",
    "tracked-built-ins": "^4.1.2",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  }
}
