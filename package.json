{
  "name": "hyperchannel",
  "version": "0.14.1",
  "description": "Kosmos Web Client",
  "repository": "https://github.com/67P/hyperchannel",
  "license": "MPL",
  "author": "Kosmos Community",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "private": true,
  "scripts": {
    "format": "prettier . --cache --write",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\" --prefixColors auto && npm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "NODE_ENV=development ember serve",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "build": "NODE_ENV=production ember build --environment=production",
    "build-prod": "NODE_ENV=production rm -rf release/* && ember build -prod --output-path release",
    "preversion": "npm test",
    "version": "npm run build-prod && git add release/",
    "deploy": "git push 5apps master"
  },
  "engines": {
    "node": ">= 18"
  },
  "ember": {
    "edition": "octane"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@csstools/postcss-sass": "^5.0.1",
    "@ember/optional-features": "^2.2.0",
    "@ember/render-modifiers": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.2.1",
    "@ember/test-waiters": "^3.1.0",
    "@embroider/macros": "^1.17.2",
    "@eslint/js": "^9.25.1",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@kosmos/remotestorage-module-kosmos": "^2.2.0",
    "@tailwindcss/forms": "^0.4.1",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.9.19",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^9.1.2",
    "consistent-color-generation": "0.4.0",
    "ember-auto-import": "^2.10.0",
    "ember-autofocus-modifier": "^3.1.0",
    "ember-body-class": "^2.1.1",
    "ember-cached-decorator-polyfill": "^0.1.4",
    "ember-cli": "~6.4.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-deprecation-workflow": "^3.3.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-inline-content": "^0.4.1",
    "ember-cli-postcss": "^8.2.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-concurrency": "^2.3.7",
    "ember-fetch": "^8.1.2",
    "ember-keyboard-shortcuts": "github:67P/ember-keyboard-shortcuts#feature/octane_classes",
    "ember-lifeline": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.2.0",
    "ember-moment": "^10.0.0",
    "ember-page-title": "^9.0.1",
    "ember-promise-modals": "^5.0.1",
    "ember-qunit": "^9.0.2",
    "ember-resolver": "^13.1.1",
    "ember-sinon": "^5.0.0",
    "ember-sinon-qunit": "^6.0.0",
    "ember-source": "~6.4.0",
    "ember-template-imports": "^4.3.0",
    "ember-template-lint": "^6.1.0",
    "ember-truth-helpers": "^3.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.5.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-qunit": "^8.1.2",
    "globals": "^15.15.0",
    "hammerjs": "^2.0.8",
    "inobounce": "^0.2.1",
    "linkify-string": "^4.1.1",
    "linkifyjs": "^4.1.1",
    "loader.js": "^4.7.0",
    "localforage": "^1.10.0",
    "moment": "^2.29.4",
    "postcss": "8.4.24",
    "postcss-scss": "4.0.6",
    "prettier-plugin-ember-template-tag": "^2.0.5",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "remotestoragejs": "^2.0.0-beta.6",
    "sinon": "^21.0.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.3.2",
    "tracked-built-ins": "^3.4.0",
    "webpack": "^5.99.7"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.2"
  }
}
